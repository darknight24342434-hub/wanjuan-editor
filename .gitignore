# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime data. The project's original .gitignore covered only data/*.db, which let
# data/access.json through — a plaintext shared password, allow_external:true and a
# live tunnel hostname. Everything under data/ is now excluded EXCEPT the three
# configuration files the application ships with.
data/*
!data/engine.json
!data/media_config.json
!data/writer_cards.json

logs/
uploads/
output/

# Secrets & local config
.env
.env.*
!.env.example
*.local.json
access.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local backups (never commit these)
*.bak
*.bak_*
*.orig
