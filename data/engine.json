{
  "name": "codex_cli",
  "command": [
    "codex",
    "exec",
    "--ephemeral",
    "--ignore-user-config",
    "--skip-git-repo-check",
    "--sandbox",
    "read-only",
    "--color",
    "never",
    "-c",
    "model=\"gpt-5.5\"",
    "-c",
    "model_reasoning_effort=\"medium\"",
    "--output-schema",
    "{schema_path}",
    "--output-last-message",
    "{output_path}",
    "-"
  ],
  "timeout_seconds": 600,
  "output": "file",
  "network_disclosure": "稿件由本機命令啟動；Codex CLI 會透過既有 OpenAI 供應商通道處理，設定檔不含憑證。"
}
